            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Disable 2FA. Requires current TOTP code."
        },
        {
          "info": {
            "name": "Regenerate Recovery Codes Package Alias",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.hevn.finance/api/v1/auth/user/2fa/recovery-codes",
