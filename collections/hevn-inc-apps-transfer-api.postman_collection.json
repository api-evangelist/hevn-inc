              "raw": "{\n  \"contactId\": \"<uuid>\",\n  \"quoteId\": \"<string>\",\n  \"invoiceId\": \"<uuid>\",\n  \"amount\": \"<number>\",\n  \"memo\": \"<string>\"\n}",
