              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "chat_type",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Send a message in the chat."
        },
        {
          "info": {
            "name": "Mark chat as read by the user",
