            "url": "https://api.hevn.finance/api/v1/team/invite",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Send an invite to the specified email and track the corresponding analytics event."
        },
