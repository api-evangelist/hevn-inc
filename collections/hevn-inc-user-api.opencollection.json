          "info": {
            "name": "Create or get current user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.hevn.finance/api/v1/user/kyc",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create or update user profile data for KYC."
        },
