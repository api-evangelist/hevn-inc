                "name": "device-type",
                "value": ""
              },
              {
                "name": "device-name",
                "value": ""
              },
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
